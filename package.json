{
  "name": "@seoinjector/sdk",
  "version": "1.0.0-alpha.1",
  "description": "Universal JavaScript/TypeScript SDK for SEO Injector - Dynamic SEO metadata management",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && rollup -c",
    "dev": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "seo",
    "metadata",
    "injection",
    "dynamic",
    "infrastructure"
  ],
  "author": "SEO Injector",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "jest": "^29.7.0",
    "react": "^19.3.0",
    "rollup": "^4.35.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seoinjector/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/seoinjector/sdk/issues"
  },
  "homepage": "https://github.com/seoinjector/sdk#readme"
}
